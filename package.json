{
  "name": "spherse",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/i18n",
    "packages/presets",
    "packages/sdk",
    "packages/core",
    "packages/server",
    "packages/app",
    "packages/web",
    "packages/desktop",
    "packages/landing"
  ],
  "scripts": {
    "predev": "node scripts/rebuild-native.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:desktop": "npm run build -w @spherse/i18n -w @spherse/presets -w @spherse/sdk -w @spherse/core -w @spherse/server -w @spherse/desktop",
    "build:web": "npm run build -w @spherse/i18n -w @spherse/presets -w @spherse/sdk -w @spherse/core -w @spherse/server -w @spherse/web",
    "build:landing": "npm run build -w @spherse/i18n -w @spherse/landing",
    "check:i18n": "npm run check -w @spherse/i18n",
    "dev": "npm run dev -w @spherse/desktop",
    "dist": "npm run dist -w @spherse/desktop",
    "dist:mac": "npm run dist:mac -w @spherse/desktop",
    "dist:win": "npm run dist:win -w @spherse/desktop",
    "dev:landing": "npm run dev -w @spherse/landing",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run lint && npm run build && npm run typecheck && npm test --workspaces --if-present && npm run check:i18n",
    "verify:e2e": "npm run verify && npm run test:e2e -w @spherse/desktop",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7"
  }
}
