{
  "name": "spherse",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/rebuild-native.mjs",
    "build": "npm run build -w @spherse/i18n && npm run build -w @spherse/core && npm run build -w @spherse/presets && npm run build -w @spherse/server && npm run build -w @spherse/app",
    "check:i18n": "npm run check -w @spherse/i18n",
    "dev": "npm run dev --workspace=packages/app",
    "dist": "npm run dist --workspace=packages/app",
    "dist:mac": "npm run dist:mac --workspace=packages/app",
    "dist:win": "npm run dist:win --workspace=packages/app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7"
  }
}
