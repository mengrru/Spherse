{
  "name": "@spherse/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./browser": "./dist/browser.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
