    "@spherse/presets": "^0.1.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^3.3.12",
    "pino": "^10.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
