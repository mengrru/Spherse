{
  "name": "@spherse/desktop",
  "productName": "Spherse",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "pretest": "npm run build --workspace=@spherse/i18n",
    "test": "vitest run",
    "pretest:e2e": "node ../../scripts/rebuild-native.mjs",
    "test:e2e": "npm run build --workspace=@spherse/i18n && npm run build && playwright test -c playwright.config.ts",
    "pack": "electron-builder --dir",
    "predist": "node ../../scripts/rebuild-native.mjs && electron-vite build",
    "dist": "electron-builder",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@spherse/core": "*",
    "@spherse/i18n": "*",
    "@spherse/server": "*",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.5.0",
    "@playwright/test": "^1.60.0",
    "@spherse/app": "*",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "41.10.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "fastify": "^5.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.16.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6",
    "zustand": "^5.0.14"
  }
}
